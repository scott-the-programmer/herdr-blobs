{
  "id": "root",
  "type": "column",
  "theme": "moss",
  "ui_font": "Geist",
  "font": "JetBrains Mono",
  "font_size": 13,
  "background": "#101913",
  "colors": {
    "background": "#131c17",
    "foreground": "#edf0e5",
    "border": "#303b34",
    "accent": "#b5d97b"
  },
  "preview": "preview.png",
  "gap": 0,
  "children": [
    {
      "id": "garden-header",
      "type": "block",
      "size": {
        "px": 58
      },
      "content": {
        "mod": "blob-garden",
        "props": {
          "role": "header"
        }
      }
    },
    {
      "id": "blob-main",
      "type": "column",
      "size": {
        "weight": 1
      },
      "min": 220,
      "children": [
        {
          "id": "blob-workspace-toolbar",
          "type": "block",
          "size": {
            "px": 36
          },
          "content": {
            "mod": "blob-workspace"
          }
        },
        {
          "id": "blob-main-body",
          "type": "row",
          "children": [
            {
              "id": "blob-main-stack",
              "type": "stack",
              "size": {
                "weight": 2
              },
              "active": "garden-board",
              "children": [
                {
                  "id": "garden-board",
                  "type": "block",
                  "content": {
                    "mod": "blob-garden",
                    "props": {
                      "role": "board"
                    }
                  }
                }
              ]
            },
            {
              "id": "blob-panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 320
              },
              "min": 260,
              "max": 700,
              "children": [
                {
                  "id": "blob-panel-stack",
                  "type": "stack",
                  "active": "blob-changes",
                  "children": [
                    {
                      "id": "blob-files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "blob-changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "session",
      "type": "column",
      "size": {
        "weight": 1
      },
      "min": 180,
      "border": {
        "width": 1,
        "color": "#303b34"
      },
      "children": [
        {
          "id": "session-label",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "blob-tabs"
          }
        },
        {
          "id": "session-terminal",
          "type": "block",
          "content": {
            "tab": "active"
          },
          "padding": [
            6,
            14
          ],
          "size": {
            "weight": 1
          }
        }
      ]
    }
  ]
}
